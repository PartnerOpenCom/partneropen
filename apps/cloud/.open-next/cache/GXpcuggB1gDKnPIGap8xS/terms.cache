id\":\"publishing\",\"className\":\"legal-section\",\"aria-labelledby\":\"terms-publishing-title\",\"children\":[[\"$\",\"p\",null,{\"className\":\"eyebrow\",\"children\":\"02 / PUBLISHING AND LINKS\"}],[\"$\",\"h2\",null,{\"id\":\"terms-publishing-title\",\"children\":\"A visible, same-origin path to every destination\"}],[\"$\",\"p\",null,{\"children\":[\"In M1, a partner publishes through the signed \",[\"$\",\"code\",null,{\"children\":\"partneropen/v1\"}],\" API, normally using the reference sync client. The Connector validates snapshots, limits block types, sanitizes rich text and stores the accepted version locally.\"]}],[\"$\",\"p\",null,{\"children\":\"Every external destination must use HTTPS and an allowed host. Public HTML uses a same-origin resolver, shows “Disclosure: This is an affiliate link.” and uses rel=\\\"sponsored nofollow noopener\\\". The rendered page never exposes a raw external href.\"}],[\"$\",\"p\",null,{\"children\":[\"Cloud API requests are accepted only from the host allowlist: \",[[\"$\",\"span\",\"partneropen.com\",{\"children\":[\"\",[\"$\",\"code\",null,{\"children\":\"partneropen.com\"}]]}],[\"$\",\"span\",\"www.partneropen.com\",{\"children\":[\", \",[\"$\",\"code\",null,{\"children\":\"www.partneropen.com\"}]]}]],\". The site owner is responsible for the destination and any additional relationship or legal notice required by its jurisdiction.\"]}]]}]\nb:[\"$\",\"section\",null,{\"id\":\"controls\",\"className\":\"legal-section\",\"aria-labelledby\":\"terms-controls-title\",\"children\":[[\"$\",\"p\",null,{\"className\":\"eyebrow\",\"children\":\"03 / OWNER CONTROLS\"}],[\"$\",\"h2\",null,{\"id\":\"terms-controls-title\",\"children\":\"Two controls, with no hidden control plane\"}],[\"$\",\"ul\",null,{\"className\":\"legal-list\",\"children\":[[\"$\",\"li\",\"Global Pause\",{\"children\":[\"$\",\"strong\",null,{\"children\":\"Global Pause\"}]}],[\"$\",\"li\",\"Withdraw consent & disconnect\",{\"children\":[\"$\",\"strong\",null,{\"children\":\"Withdraw consent & disconnect\"}]}]]}],[\"$\",\"p\",null,{\"children\":\"Global Pause is a separate publication overlay. It makes public Space pages, agent assets and resolver requests return a no-store 404; it does not delete state, revoke a partner or change the local snapshot. Resume restores an active published snapshot.\"}],[\"$\",\"p\",null,{\"children\":\"Disconnect is consent withdrawal and unpairing, never partner removal. It revokes the site secret, stops outbound calls, marks the connection disconnected, and retains local snapshots until explicit deletion. No Cloud-side snapshot, metrics or agent-file copy is stored in this M1; future service data is governed by that service's notice. Reconnection requires fresh consent and a fresh pairing code.\"}],[\"$\",\"p\",null,{\"children\":\"Withdrawal of an optional scope takes effect at that scope's boundary. The owner can explicitly delete local snapshots separately; disconnect never silently removes the partner or claims to erase another service's data.\"}]]}]\nc:[\"$\",\"section\",null,{\"id\":\"retention\",\"className\":\"legal-section\",\"aria-labelledby\":\"terms-retention-title\",\"children\":[[\"$\",\"p\",null,{\"className\":\"eyebrow\",\"children\":\"04 / RETENTION AND MILESTONES\"}],[\"$\",\"h2\",null,{\"id\":\"terms-retention-title\",\"children\":\"WordPress remains the durable system of record\"}],[\"$\",\"p\",null,{\"children\":\"The latest published snapshot remains on this site until it is replaced or explicitly deleted. Aggregate click totals are retained locally for 90 days, then pruned by a daily job. Uninstall deletes the plugin options, snapshots, click totals and plugin transients.\"}],[\"$\",\"p\",null,{\"children\":\"The site secret is stored in a non-autoloaded WordPress option, returned exactly once during pairing and never included in REST status, snapshots or public agent files. PartnerOpen Cloud keeps no snapshot, metrics or agent-file copy in this milestone because there is no Cloud ingest endpoint.\"}],[\"$\",\"p\",null,{\"children\":\"The tenant-backed partner editor is a deferred milestone. Passwordless login, tenant and Space isolation, hosted page editing, email delivery, Cloud-side metrics storage, billing and service/network adapters are not promises of this M1 site.\"}]]}]\nd:[\"$\",\"section\",null,{\"id\":\"responsibility\",\"className\":\"legal-section\",\"aria-labelledby\":\"terms-responsibility-title\",\"children\":[[\"$\",\"p\",null,{\"className\":\"eyebrow\",\"children\":\"05 / RESPONSIBILITY\"}],[\"$\",\"h2\",null,{\"id\":\"terms-responsibility-title\",\"children\":\"Use the Connector lawfully\"}],[\"$\",\"p\",null,{\"children\":\"The site owner is responsible for choosing lawful destinations, maintaining an accurate disclosure, publishing any additional notice required for the site audience and reviewing the configured consent scopes.\"}],[\"$\",\"p\",null,{\"children\":\"PartnerOpen does not guarantee ranking, placement, moderation, approval, conversions, revenue or availability of any external destination. Users must comply with the laws, terms and policies applicable to their sites and destinations.\"}]]}]\ne:[\"$\",\"aside\",null,{\"className\":\"legal-aside\",\"aria-label\":\"Terms summary\",\"children\":[[\"$\",\"div\",null,{\"className\":\"legal-aside-card\",\"children\":[[\"$\",\"p\",null,{\"className\":\"eyebrow\",\"children\":\"QUICK FACTS\"}],[\"$\",\"dl\",null,{\"className\":\"legal-facts\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"dt\",null,{\"children\":\"Product\"}],[\"$\",\"dd\",null,{\"children\":\"GPL-2.0-or-later Connector\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"dt\",null,{\"children\":\"State\"}],[\"$\",\"dd\",null,{\"children\":\"WordPress options\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"dt\",null,{\"children\":\"Cloud\"}],[\"$\",\"dd\",null,{\"children\":\"Stateless public site\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"dt\",null,{\"children\":\"Controls\"}],[\"$\",\"dd\",null,{\"children\":\"Global Pause + disconnect\"}]]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"legal-aside-card\",\"children\":[[\"$\",\"p\",null,{\"className\":\"eyebrow\",\"children\":\"CLOUD HOST ALLOWLIST\"}],[\"$\",\"ul\",null,{\"className\":\"legal-host-list\",\"children\":[[\"$\",\"li\",\"partneropen.com\",{\"children\":[\"$\",\"code\",null,{\"children\":\"partneropen.com\"}]}],[\"$\",\"li\",\"www.partneropen.com\",{\"children\":[\"$\",\"code\",null,{\"children\":\"www.partneropen.com\"}]}]]}]]}]]}]\nf:[\"$\",\"footer\",null,{\"className\":\"footer legal-footer\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"PartnerOpen Cloud / public site · v\",\"0.1.0\"]}],[\"$\",\"span\",null,{\"children\":[[\"$\",\"$L2\",null,{\"className\":\"text-link\",\"href\":\"/privacy\",\"children\":\"privacy\"}],\" · \",[\"$\",\"$L2\",null,{\"className\":\"text-link\",\"href\":\"/\",\"children\":\"home\"}]]}]]}]\n10:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/22i43cg4l4-dq.js\",\"async\":true}]\n11:[\"$\",\"$L1d\",null,{\"children\":[\"$\",\"$1e\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@1f\"}]}]\n14:[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L20\",null,{\"children\":[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L21\",null,{\"children\":[\"$\",\"$1e\",null,{\"name\":\"Next.Metadata\",\"children\":[[\"$\",\"title\",\"0\",{\"children\":\"Terms of use · PartnerOpen Cloud\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Terms for PartnerOpen Connector and the stateless PartnerOpen Cloud site.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/icon.png?icon.1hy_obdcqas7n.png\",\"sizes\":\"512x512\",\"type\":\"image/png\"}],[\"$\",\"link\",\"3\",{\"rel\":\"icon\",\"href\":\"/icon.svg?icon.3nogjgb7pze-4.svg\",\"sizes\":\"any\",\"ty