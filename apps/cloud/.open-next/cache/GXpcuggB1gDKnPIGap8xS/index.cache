,{\"children\":[\"What does the Connector store?\",[\"$\",\"span\",null,{\"children\":\"+\"}]]}],[\"$\",\"p\",null,{\"children\":\"The Connector stores pairing, consent, Space, published snapshot and aggregate counter state in WordPress options. WordPress remains the durable system of record for the public runtime.\"}]]}],[\"$\",\"details\",\"Can the Creator publish without a Host step?\",{\"className\":\"faq\",\"children\":[[\"$\",\"summary\",null,{\"children\":[\"Can the Creator publish without a Host step?\",[\"$\",\"span\",null,{\"children\":\"+\"}]]}],[\"$\",\"p\",null,{\"children\":\"Yes. After setup and the required consent scopes, the Creator publishes through the signed API, MCP or PartnerOpen GUI. The Host keeps Global Pause, consent withdrawal and disconnect as the public overlay.\"}]]}],[\"$\",\"details\",\"Are links redirected invisibly?\",{\"className\":\"faq\",\"children\":[[\"$\",\"summary\",null,{\"children\":[\"Are links redirected invisibly?\",[\"$\",\"span\",null,{\"children\":\"+\"}]]}],[\"$\",\"p\",null,{\"children\":\"No. Every outbound link uses a same-origin resolver, shows a disclosure and renders rel=\\\"sponsored nofollow noopener\\\". Raw external href values are not emitted by the Connector renderer.\"}]]}],[\"$\",\"details\",\"What happens when consent is withdrawn?\",{\"className\":\"faq\",\"children\":[[\"$\",\"summary\",null,{\"children\":[\"What happens when consent is withdrawn?\",[\"$\",\"span\",null,{\"children\":\"+\"}]]}],[\"$\",\"p\",null,{\"children\":\"The Connector stops outbound exchange, revokes its site secret and marks the connection disconnected. The latest local published snapshot stays in WordPress until the owner explicitly deletes it.\"}]]}],[\"$\",\"details\",\"Does PartnerOpen process payments?\",{\"className\":\"faq\",\"children\":[[\"$\",\"summary\",null,{\"children\":[\"Does PartnerOpen process payments?\",[\"$\",\"span\",null,{\"children\":\"+\"}]]}],[\"$\",\"p\",null,{\"children\":\"No. PartnerOpen provides