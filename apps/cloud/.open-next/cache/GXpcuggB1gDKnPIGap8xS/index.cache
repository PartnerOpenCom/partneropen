\":[[\\\"$\\\",\\\"$L4\\\",null,{\\\"className\\\":\\\"brand\\\",\\\"href\\\":\\\"/\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"brand-mark\\\",\\\"children\\\":\\\"P\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"PartnerOpen\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"topbar-links\\\",\\\"children\\\":[[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#how-it-works\\\",\\\"children\\\":\\\"How to connect\\\"}],[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#where\\\",\\\"children\\\":\\\"Use cases\\\"}]]}],[\\\"$\\\",\\\"a\\\",null,{\\\"className\\\":\\\"topbar-download\\\",\\\"href\\\":\\\"/partneropen-connector-0.1.0.zip\\\",\\\"download\\\":true,\\\"children\\\":[\\\"Get WordPress Connector \\\",[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"↓\\\"}]]}]]}],[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"landing-screen hero-grid\\\",\\\"id\\\":\\\"hero\\\",\\\"aria-labelledby\\\":\\\"page-title\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"hero-copy\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"eyebrow\\\",\\\"children\\\":\\\"SET PARTNER SAFE SPACE VIA GPL WORDPRESS CONNECTOR\\\"}],[\\\"$\\\",\\\"h1\\\",null,{\\\"id\\\":\\\"page-title\\\",\\\"children\\\":\\\"Partner directory. WordPress control.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"hero-lede\\\",\\\"children\\\":\\\"PartnerOpen is a GPL WordPress Connector that makes a Host-controlled partner Space on your website. Collaborate with the best Creators while the Host keeps full control. Connect to the existing PRM (Partner Relationship Management) and CRM (Client Relationship Management), or use aggregate placement metrics to keep the operational workflows you already run.\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"hero-status-rail\\\",\\\"aria-label\\\":\\\"PartnerOpen product status\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"hero-status-rail__live\\\",\\\"children\\\":[[\\\"$\\\",\\\"i\\\",null,{}],\\\" M1 / AVAILABLE NOW\\\"]}],[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"WORDPRESS-OWNED\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"CONSENT-FIRST\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"ANY CREATOR\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"hero-actions\\\",\\\"children\\\":[[\\\"$\\\",\\\"a\\\",null,{\\\"className\\\":\\\"button button-primary\\\",\\\"href\\\":\\\"/partneropen-connector-0.1.0.zip\\\",\\\"download\\\":true,\\\"children\\\":[\\\"Download Connector v0.1.0 \\\",[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"↓\\\"}]]}],[\\\"$\\\",\\\"a\\\",null,{\\\"className\\\":\\\"button button-ghost\\\",\\\"href\\\":\\\"#where\\\",\\\"children\\\":[\\\"See the Partner Network offering \\\",[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"↘\\\"}]]}]]}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"hero-usp\\\",\\\"aria-label\\\":\\\"PartnerOpen advantages\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"SAFE\\\",{\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"hero-usp__number\\\",\\\"children\\\":\\\"01\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"SAFE\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"Thoughtful participant protection, explicit consent and a visible WordPress boundary.\\\"}]]}]]}],[\\\"$\\\",\\\"li\\\",\\\"EASY TO SET\\\",{\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"hero-usp__number\\\",\\\"children\\\":\\\"02\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"EASY TO SET\\\"}],\\\"$L5\\\"]}]]}],\\\"$L6\\\"]}],\\\"$L7\\\"]}],\\\"$L8\\\"]}],\\\"$L9\\\",\\\"$La\\\",\\\"$Lb\\\",\\\"$Lc\\\",\\\"$Ld\\\",\\\"$Le\\\",\\\"$Lf\\\",\\\"$L10\\\",\\\"$L11\\\",\\\"$L12\\\",\\\"$L13\\\",\\\"$L14\\\",\\\"$L15\\\",\\\"$L16\\\"]}],[\\\"$L17\\\"],\\\"$L18\\\"]}],{},null,false,nul