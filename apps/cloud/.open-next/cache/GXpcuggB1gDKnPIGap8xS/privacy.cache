 each scope. \",[\"$\",\"code\",null,{\"children\":\"cloud_connection\"}],\" and \",[\"$\",\"code\",null,{\"children\":\"content_sync\"}],\" are required for pairing and snapshot publication respectively. \",[\"$\",\"code\",null,{\"children\":\"partner_email\"}],\" is optional at the option level but required to send an invitation; the other scopes are optional.\"]}],[\"$\",\"div\",null,{\"className\":\"legal-table-wrap\",\"children\":[\"$\",\"table\",null,{\"className\":\"legal-scope-table\",\"children\":[[\"$\",\"caption\",null,{\"children\":\"Exact Connector consent metadata\"}],[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",null,{\"scope\":\"col\",\"children\":\"Scope\"}],[\"$\",\"th\",null,{\"scope\":\"col\",\"children\":\"Purpose\"}],[\"$\",\"th\",null,{\"scope\":\"col\",\"children\":\"Data fields\"}],[\"$\",\"th\",null,{\"scope\":\"col\",\"children\":\"Recipient\"}],[\"$\",\"th\",null,{\"scope\":\"col\",\"children\":\"Retention\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"cloud_connection\",{\"children\":[[\"$\",\"th\",null,{\"scope\":\"row\",\"children\":[[\"$\",\"code\",null,{\"children\":\"cloud_connection\"}],[\"$\",\"span\",null,{\"children\":\"Cloud connection\"}],[\"$\",\"small\",null,{\"children\":\"Required\"}]]}],[\"$\",\"td\",null,{\"children\":\"Pair this site with PartnerOpen Cloud so the delegated Space can be managed remotely.\"}],[\"$\",\"td\",null,{\"children\":\"site URL; URL prefix; technical site identifier; connector version\"}],[\"$\",\"td\",null,{\"children\":\"The paired PartnerOpen Cloud client\"}],[\"$\",\"td\",null,{\"children\":\"Until consent is withdrawn or the site is disconnected.\"}]]}],[\"$\",\"tr\",\"partner_email\",{\"children\":[[\"$\",\"th\",null,{\"scope\":\"row\",\"children\":[[\"$\",\"code\",null,{\"children\":\"partner_email\"}],[\"$\",\"span\",null,{\"children\":\"Partner invitation email\"}],[\"$\",\"small\",null,{\"children\":\"Optional\"}]]}],[\"$\",\"td\",null,{\"children\":\"Record the partner address used for the invitation and service notices for this Space.\"}],[\"$\",\"td\",null,{\"children\":\"partner email address; site URL; Space name\"}],[\"$\",\"td\",null,{\"children\":\"Stored on this site and shared with the paired client during pairing\"}],[\"$\",\"td\",null,{\"children\":\"Until consent is withdrawn. The Connector sends no email itself.\"}]]}],[\"$\",\"tr\",\"content_sync\",{\"children\":[[\"$\",\"th\",null,{\"scope\":\"row\",\"children\":[[\"$\",\"code\",null,{\"children\":\"content_sync\"}],[\"$\",\"span\",null,{\"children\":\"Content sync\"}],[\"$\",\"small\",null,{\"children\":\"Required\"}]]}],[\"$\",\"td\",null,{\"children\":\"Receive the published page snapshot that this site renders.\"}],[\"$\",\"td\",null,{\"children\":\"typed page blocks; SEO title and description; link metadata; allowed destination hosts; snapshot version\"}],[\"$\",\"td\",null,{\"children\":\"This site, received from the paired client\"}],\"$L3\"]}],\"$L4\",\"$L5\",\"$L6\"]}]]}]}],\"$L7\"]}],\"$L8\",\"$L9\",\"$La\",\"$Lb\",\"$Lc\"]}],\"$Ld\"]}],\"$Le\"]}],[\"$Lf\"],\"$L10\"]}],\"isPartial\":\"$@11\",\"staleTime\":\"$12\",\"varyParams\":null},{\"rsc\":\"$L13\",\"isPartial\":\"$@14\",\"staleTime\":\"$12\",\"varyParams\":null},{\"rsc\":\"$L15\",\"isPartial\":\"$@16\",\"staleTime\":\"$12\",\"varyParams\":\"$17\"},{\"rsc\":\"$L18\",\"isPartial\":\"$@19\",\"staleTime\":\"$12\",\"varyParams\":null}],\"isUpgradeableISRFallback\":false,\"a\":\"$@1a\",\"rootVaryParams\":null,\"needsRuntimeRequest\":\"$@1b\"}\n1c:I[97367,[\"/_next/static/chunks/3fntmmi971322.js\"],\"OutletBoundary\"]\n1d:\"$Sreact.suspense\"\n1f:I[97367,[\"/_next/static/chunks/3fntmmi971322.js\"],\"ViewportBoundary\"]\n20:I[97367,[\"/_next/static/chunks/3fntmmi971322.js\"],\"MetadataBoundary\"]\n21:I[27201,[\"/_next/static/chunks/3fntmmi971322.js\"],\"IconMark\"]\n22:I[39756,[\"/_next/static/chunks/3fntmmi971322.js\"],\"default\"]\n23:I[37457,[\"/_next/static/chunks/3fntmmi971322.js\"],\"default\"]\n:HL[\"/_next/static/chunks/3gbq_omz-fxf5.css\",\"style\"]\n3:[\"$\",\"td\",null,{\"children\":\"The latest snapshot stays on this site until it is replaced or deleted. No Cloud copy is kept in this milestone.\"}]\n4:[\"$\",\"tr\",\"agent_pack\",{\"children\":[[\"$\",\"th\",null,{\"scope\":\"row\",\"children\":[[\"$\",\"code\",null,{\"children\":\"agent_pack\"}],[\"$\",\"span\",null,{\"children\":\"Agent context files\"}],[\"$\",\"small\",null,{\"children\":\"Optional\"}]]}],[\"$\",\"td\",null,{\"children\":\"Publish AGENTS.md, llms.txt, ai-context.json, manifest.json and sitemap.xml for the delegated Space.\"}],[\"$\",\"td\",null,{\"children\":\"public Space title and summary; public page URLs; allowed block types\"}],[\"$\",\"td\",null,{\"children\":\"Public visitors and AI agents\"}],[\"$\",\"td\",null,{\"children\":\"Served while the Space is published.\"}]]}]\n5:[\"$\",\"tr\",\"aggregate_metrics\",{\"children\":[[\"$\",\"th\",null,{\"scope\":\"row\",\"children\":[[\"$\",\"code\",null,{\"children\":\"aggregate_metrics\"}],[\"$\",\"span\",null,{\"children\":\"Aggregate click counters\"}],[\"$\",\"small\",null,{\"children\":\"Optional\"}]]}],[\"$\",\"td\",null,{\"children\":\"Record daily click totals per placement so the partner can measure placements.\"}],[\"$\",\"td\",null,{\"children\":\"date; placement identifier; click count\"}],[\"$\",\"td\",null,{\"children\":\"Stored on this site and readable by the paired client through the signed metrics route\"}],[\"$\",\"td\",null,{\"children\":\"90 days on this site, then deleted.\"}]]}]\n6:[\"$\",\"tr\",\"affiliate_service\",{\"children\":[[\"$\",\"th\",null,{\"scope\":\"row\",\"children\":[[\"$\",\"code\",null,{\"children\":\"affiliate_service\"}],[\"$\",\"span\",null,{\"children\":\"Affiliate service links\"}],[\"$\",\"small\",null,{\"children\":\"Optional\"}]]}],[\"$\",\"td\",null,{\"children\":\"Allow links supplied by connected affiliate services to be published in this Space with disclosure.\"}],[\"$\",\"td\",null,{\"children\":\"approved public link identifier; placement identifier; disclosure text\"}],[\"$\",\"td\",null,{\"children\":\"Published on this site with disclosure; no service credentials are stored here\"}],[\"$\",\"td\",null,{\"children\":\"Until consent is withdrawn.\"}]]}]\n7:[\"$\",\"p\",null,{\"children\":[\"agent_pack is enforced locally at publication time. When it is withdrawn, AGENTS.md, the lowercase agents.md alias, llms.txt, ai-context.json, manifest.json and sitemap.xml return 404 with no-store semantics.\",\" The Space page and same-origin resolver continue under their Global Pause and Space-status rules.\"]}]\n8:[\"$\",\"section\",null,{\"id\":\"never-collected\",\"className\":\"legal-section\",\"aria-labelledby\":\"privacy-never-title\",\"children\":[[\"$\",\"p\",null,{\"className\":\"eyebrow\",\"children\":\"02 / NEVER COLLECTED\"}],[\"$\",\"h2\",null,{\"id\":\"privacy-never-title\",\"children\":\"Aggregate measurement, not visitor dossiers\"}],[\"$\",\"p\",null,{\"children\":\"The Connector does not collect or send the following:\"}],[\"$\",\"ul\",null,{\"className\":\"legal-never-list\",\"children\":[[\"$\",\"li\",\"cookies\",{\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"children\":\"×\"}],\"cookies\"]}],[\"$\",\"li\",\"IP addresses\",{\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"children\":\"×\"}],\"IP addresses\"]}],[\"$\",\"li\",\"user agents\",{\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"children\":\"×\"}],\"user agents\"]}],[\"$\",\"li\",\"device fingerprints\",{\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"children\":\"×\"}],\"device fingerprints\"]}],[\"$\",\"li\",\"unique visitor identifiers\",{\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"children\":\"×\"}],\"unique visitor identifiers\"]}],[\"$\",\"li\",\"visitor-level click events\",{\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"children\":\"×\"}],\"visitor-level click events\"]}]]}],[\"$\",\"p\",null,{\"children\":\"Measurements are aggregate daily counts per placement. There is no per-visitor analytics, fingerprinting or hidden identifier in a resolver request. A destination service may process a visitor after a redirect under that service's own notice; the Connector does not add visitor identity to the redirect.\"}]]}]\n9:[\"$\",\"section\",null,{\"id\":\"local-cloud\",\"className\":\"legal-section\",\"aria-labelledby\":\"privacy-local-title\",\"children\":[[\"$\",\"p\",null,{\"className\":\"eyebrow\",\"children\":\"03 / LOCAL AND CLOUD DATA\"}],[\"$\",\"h2\",null,{\"id\":\"privacy-local-title\",\"children\":\"Local-first by construction\"}],[\"$\",\"p\",null,{\"children\":\"Before cloud_connection consent, the Connector makes zero outbound HTTP requests, including no request to Cloud. Each payload is independently gated by its named scope.\"}],[\"$\",\"p\",null,{\"children\":\"Once paired, the Connector sends only the payload allowed by the granted scope and the signed API contract. The site secret is stored in a non-autoloaded WordPress option, returned exactly once during pairing and never included in REST status, snapshots or public agent files.\"}],[\"$\",\"p\",null,{\"children\":\"The latest published snapshot remains on this site until it is replaced or explicitly deleted. Aggregate click totals are retained locally for 90 days, then pruned by a daily job. Uninstall deletes the plugin options, snapshots, click totals and plugin transients.\"}],[\"$\",\"p\",null,{\"children\":\"Agent files are assembled from a positive public field allowlist, so link destinations, contact addresses, identifiers, service or payout data and unknown fields are dropped rather than filtered out. In M1, PartnerOpen Cloud keeps no snapshot, metrics or agent-file copy: the Connector is the store of record and there is no Cloud ingest endpoint.\"}]]}]\na:[\"$\",\"section\",null,{\"id\":\"withdrawal\",\"className\":\"legal-section\",\"aria-labelledby\":\"privacy-withdrawal-title\",\"children\":[[\"$\",\"p\",null,{\"className\":\"eyebrow\",\"children\":\"04 / WITHDRAWAL AND DISCONNECT\"}],[\"$\",\"h2\",null,{\"id\":\"privacy-withdrawal-title\",\"children\":\"Two independent owner controls\"}],[\"$\",\"ul\",null,{\"className\":\"legal-list\",\"children\":[[\"$\",\"li\",\"Global Pause\",{\"children\":[\"$\",\"strong\",null,{\"children\":\"Global Pause\"}]}],[\"$\",\"li\",\"Withdraw consent & disconnect\",{\"children\":[\"$\",\"strong\",null,{\"children\":\"Withdraw consent & disconnect\"}]}]]}],[\"$\",\"p\",null,{\"children\":\"Disconnect is consent withdrawal and unpairing, never partner removal. It revokes the site secret, stops outbound calls, marks the connection disconnected, and retains local snapshots until explicit deletion. No Cloud-side snapshot, metrics or agent-file copy is stored in this M1; future service data is governed by that service's notice. Reconnection requires fresh consent and a fresh pairing code.\"}],[\"$\",\"p\",null,{\"children\":\"Withdrawal of an optional scope is enforced at its own boundary. The owner can explicitly delete local snapshots separately. No Cloud-side snapshot, metrics or agent-file copy is stored in this M1; future service data is governed by that service's notice.\"}],[\"$\",\"p\",null,{\"children\":\"Global Pause temporarily overlays all public Space, resolver and agent routes with a no-store 404. It does not delete state or revoke consent; resuming restores the retained published snapshot when the Space is active.\"}]]}]\nb:[\"$\",\"section\",null,{\"id\":\"hosts-and-milestones\",\"className\":\"legal-section\",\"aria-labelledby\":\"privacy-hosts-title\",\"children\":[[\"$\",\"p\",null,{\"className\":\"eyebrow\",\"children\":\"05 / CLOUD BOUNDARY\"}],[\"$\",\"h2\",null,{\"id\":\"privacy-hosts-title\",\"children\":\"A narrow host allowlist and a deferred editor\"}],[\"$\",\"p\",null,{\"children\":[\"Cloud pairing accepts only these hosts: \",[[\"$\",\"span\",\"partneropen.com\",{\"children\":[\"\",[\"$\",\"code\",null,{\"children\":\"partneropen.com\"}]]}],[\"$\",\"span\",\"www.partneropen.com\",{\"children\":[\", \",[\"$\",\"code\",null,{\"children\":\"www.partneropen.com\"}]]}]],\". The Cloud site is stateless and has no tenant database, hosted editor, pairing store, publish store or metrics-ingest store in this milestone.\"]}],[\"$\",\"p\",null,{\"children\":\"The tenant-backed partner editor is a deferred milestone. Passwordless login, tenant and Space isolation, hosted page editing, email delivery, Cloud-side metrics storage, billing and service/network adapters are not promises of this M1 site.\"}],[\"$\",\"p\",null,{\"children\":\"Every external destination must use HTTPS and an allowed host. Public HTML uses a same-origin resolver, shows “Disclosure: This is an affiliate link.” and uses rel=\\\"sponsored nofollow noopener\\\". The rendered page never exposes a raw external href.\"}]]}]\nc:[\"$\",\"section\",null,{\"id\":\"responsibility\",\"className\":\"legal-section\",\"aria-labelledby\":\"privacy-responsibility-title\",\"children\":[[\"$\",\"p\",null,{\"className\":\"eyebrow\",\"children\":\"06 / OWNER RESPONSIBILITY\"}],[\"$\",\"h2\",null,{\"id\":\"privacy-responsibility-title\",\"children\":\"Review the boundary and your destinations\"}],[\"$\",\"p\",null,{\"children\":\"The site owner is responsible for choosing lawful destinations, maintaining an accurate disclosure, publishing any additional notice required for the site audience and reviewing the configured consent scopes.\"}]]}]\nd:[\"$\",\"aside\",null,{\"className\":\"legal-aside\",\"aria-label\":\"Privacy summary\",\"children\":[[\"$\",\"div\",null,{\"className\":\"legal-aside-card\",\"children\":[[\"$\",\"p\",null,{\"className\":\"eyebrow\",\"children\":\"PRIVACY AT A GLANCE\"}],[\"$\",\"dl\",null,{\"className\":\"legal-facts\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"dt\",null,{\"children\":\"Outbound HTTP\"}],[\"$\",\"dd\",null,{\"children\":\"Zero before cloud consent\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"dt\",null,{\"children\":\"Measurement\"}],[\"$\",\"dd\",null,{\"children\":\"Date · placement · count\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"dt\",null,{\"children\":\"Snapshot\"}],[\"$\",\"dd\",null,{\"children\":\"Local until replaced or deleted\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"dt\",null,{\"children\":\"Clicks\"}],[\"$\",\"dd\",null,{\"children\":\"90 days, daily prune\"}]]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"legal-aside-card\",\"children\":[[\"$\",\"p\",null,{\"className\":\"eyebrow\",\"children\":\"CLOUD HOST ALLOWLIST\"}],[\"$\",\"ul\",null,{\"className\":\"legal-host-list\",\"children\":[[\"$\",\"li\",\"partneropen.com\",{\"children\":[\"$\",\"code\",null,{\"children\":\"partneropen.com\"}]}],[\"$\",\"li\",\"www.partneropen.com\",{\"children\":[\"$\",\"code\",null,{\"children\":\"www.partneropen.com\"}]}]]}]]}]]}]\ne:[\"$\",\"footer\",null,{\"className\":\"footer legal-footer\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"PartnerOpen Cloud / public site · v\",\"0.1.0\"]}],[\"$\",\"span\",null,{\"children\":[[\"$\",\"$L2\",null,{\"className\":\"text-link\",\"href\":\"/terms\",\"children\":\"terms\"}],\" · \",[\"$\",\"$L2\",null,{\"className\":\"text-link\",\"href\":\"/\",\"children\":\"home\"}]]}]]}]\nf:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/22i43cg4l4-dq.js\",\"async\":true}]\n10:[\"$\",\"$L1c\",null,{\"children\":[\"$\",\"$1d\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@1e\"}]}]\n13:[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L1f\",null,{\"children\":[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L20\",null,{\"children\":[\"$\",\"$1d\",null,{\"name\":\"Next.Metadata\",\"children\":[[\"$\",\"title\",\"0\",{\"c