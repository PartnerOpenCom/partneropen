# Local runtime defaults. Never commit real credentials.
NODE_ENV=development
APP_BASE_URL=http://localhost:3001

# Required for database-backed control-plane work; no in-memory production fallback.
# DATABASE_URL=postgres://partneropen:partneropen@127.0.0.1:55432/partneropen_control

# Required for auth and encrypted Connector credentials in staging/production.
# AUTH_TOKEN_PEPPER=replace-with-a-random-secret-at-least-32-characters
# ENCRYPTION_KEY=64-lowercase-hex-characters-for-a-32-byte-key
ENCRYPTION_KEY_VERSION=1
SESSION_COOKIE_NAME=partneropen_session
SESSION_TTL_SECONDS=2592000
CONNECTOR_REQUEST_TIMEOUT_MS=10000

# Required before passwordless email delivery is enabled in staging/production.
# RESEND_API_KEY=re_...
# EMAIL_FROM=PartnerOpen <noreply@example.com>
