{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://partneropen.com/schema/snapshot.json",
  "title": "PartnerOpen canonical snapshot",
  "description": "Canonical public snapshot accepted by PartnerOpen Connector. The version is the snapshot format version, currently 3.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "space", "blocks", "links"],
  "properties": {
    "version": {
      "const": 3,
      "description": "Snapshot format version, currently 3."
    },
    "space": {
      "$ref": "#/$defs/space"
    },
    "seo": {
      "$ref": "#/$defs/seo"
    },
    "allowed_hosts": {
      "type": "array",
      "description": "Lowercase destination hostnames permitted by the same-origin resolver. Link destinations must be HTTPS and match one of these hosts.",
      "items": {
        "type": "string",
        "pattern": "^(?=.{1,253}$)(?!.*\\.\\.)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)*[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
      },
      "uniqueItems": true
    },
    "blocks": {
      "type": "array",
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/hero"},
          {"$ref": "#/$defs/text"},
          {"$ref": "#/$defs/cards"},
          {"$ref": "#/$defs/cta"},
          {"$ref": "#/$defs/link"},
          {"$ref": "#/$defs/faq"},
          {"$ref": "#/$defs/comparison"},
          {"$ref": "#/$defs/table"},
          {"$ref": "#/$defs/image"}
        ]
      }
    },
    "links": {
      "type": "object",
      "description": "Map of stable link ids to approved destinations and placement metadata.",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_-]{1,64}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/linkRecord"
      }
    },
    "agent": {
      "$ref": "#/$defs/agent"
    }
  },
  "$defs": {
    "space": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "slug", "title", "status"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]{2,64}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "enum": ["draft", "published", "suspended"]
        }
      }
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "maxLength": 320
        },
        "canonical": {
          "type": "string",
          "description": "HTTPS canonical URL whose scheme, host, and port match the connected site's home_url(); foreign origins are rejected.",
          "pattern": "^https://"
        }
      }
    },
    "linkRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["link_id", "placement_id", "label"],
      "properties": {
        "link_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
        "placement_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
        "label": {"type": "string", "minLength": 1, "maxLength": 160}
      }
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "heading", "lede", "link_id", "placement_id", "label"],
      "properties": {
        "type": {"const": "hero"},
        "heading": {"type": "string", "minLength": 1, "maxLength": 200},
        "lede": {"type": "string", "maxLength": 500},
        "link_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
        "placement_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
        "label": {"type": "string", "minLength": 1, "maxLength": 160}
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "html"],
      "properties": {
        "type": {"const": "text"},
        "html": {"type": "string", "description": "Sanitized rich text; anchors and executable content are not accepted."}
      }
    },
    "cards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": {"const": "cards"},
        "items": {"type": "array", "items": {"$ref": "#/$defs/card"}}
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body", "link_id", "placement_id", "label"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "body": {"type": "string", "maxLength": 1000},
        "link_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
        "placement_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
        "label": {"type": "string", "minLength": 1, "maxLength": 160}
      }
    },
    "cta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "label", "link_id", "placement_id"],
      "properties": {
        "type": {"const": "cta"},
        "label": {"type": "string", "minLength": 1, "maxLength": 160},
        "link_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
        "placement_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"}
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "link_id", "placement_id", "label"],
      "properties": {
        "type": {"const": "link"},
        "link_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
        "placement_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
        "label": {"type": "string", "minLength": 1, "maxLength": 160}
      }
    },
    "faq": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": {"const": "faq"},
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["q", "a"],
            "properties": {
              "q": {"type": "string", "minLength": 1, "maxLength": 300},
              "a": {"type": "string", "minLength": 1, "maxLength": 2000}
            }
          }
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "columns", "rows"],
      "properties": {
        "type": {"const": "comparison"},
        "columns": {"type": "array", "items": {"type": "string", "maxLength": 120}},
        "rows": {"type": "array", "items": {"type": "array", "items": {"type": "string", "maxLength": 500}}}
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "columns", "rows"],
      "properties": {
        "type": {"const": "table"},
        "columns": {"type": "array", "items": {"type": "string", "maxLength": 120}},
        "rows": {"type": "array", "items": {"type": "array", "items": {"type": "string", "maxLength": 500}}}
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url", "alt"],
      "properties": {
        "type": {"const": "image"},
        "url": {"type": "string", "format": "uri", "pattern": "^https://", "description": "HTTPS image URL whose scheme, host, and port match the connected site's home_url(); remote images are rejected and never proxied."},
        "alt": {"type": "string", "maxLength": 200}
      }
    },
    "linkRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["destination", "label", "disclosure", "status", "placements"],
      "properties": {
        "destination": {"type": "string", "format": "uri", "pattern": "^https://"},
        "label": {"type": "string", "minLength": 1, "maxLength": 160},
        "disclosure": {"type": "string", "minLength": 1, "maxLength": 300},
        "status": {"enum": ["active", "inactive"]},
        "placements": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"}, "uniqueItems": true}
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {"type": "string", "maxLength": 2000},
        "instructions": {"type": "array", "items": {"type": "string", "maxLength": 1000}},
        "entities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type"],
            "properties": {
              "name": {"type": "string", "minLength": 1, "maxLength": 200},
              "type": {"type": "string", "minLength": 1, "maxLength": 120}
            }
          }
        }
      }
    }
  }
}
